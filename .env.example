# ============================================================
# CONTRACT COMPLIANCE AGENT — Environment Configuration
# Copy this file to .env and fill in ALL values.
# No defaults are used — every variable below is required
# unless marked as [OPTIONAL].
# ============================================================

# --- Azure AI Foundry (REQUIRED) ---
FOUNDRY_OPENAI_BASE_URL=https://<your-foundry-resource>.services.ai.azure.com/openai/v1
FOUNDRY_API_KEY=your_foundry_api_key_here
FOUNDRY_MODEL=gpt-4.1-mini

# --- Azure AI Document Intelligence [OPTIONAL] ---
# Only required when running with --use-doc-intel flag.
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_API_KEY=your_doc_intel_key_here

# --- Azure Monitor / Application Insights [OPTIONAL] ---
# If not set, telemetry falls back to local in-memory tracing only.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# --- Runtime Environment (REQUIRED) ---
# Values: development | staging | production
ENVIRONMENT=development

# --- Sensitive Data Logging [OPTIONAL] ---
# Set to true to include contract text in structured logs (not recommended in production).
ENABLE_SENSITIVE_DATA=false
